{
    "name": "hertel/symfony-asset-mapper-update",
    "description": "Opens and maintains pull requests for outdated and vulnerable dependencies in the importmap.php of Symfony AssetMapper apps.",
    "license": "MIT",
    "type": "project",
    "keywords": ["symfony", "asset-mapper", "importmap", "dependencies", "github-action"],
    "authors": [
        {"name": "Christopher Hertel", "email": "mail@christopher-hertel.de"}
    ],
    "require": {
        "php": ">=8.2",
        "symfony/console": "^7.4 || ^8.1",
        "symfony/filesystem": "^7.4 || ^8.1",
        "symfony/http-client": "^7.4 || ^8.1",
        "symfony/process": "^7.4 || ^8.1",
        "symfony/yaml": "^7.4 || ^8.1"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.75",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {"AssetMapperUpdate\\": "src/"}
    },
    "autoload-dev": {
        "psr-4": {"AssetMapperUpdate\\Tests\\": "tests/"}
    },
    "bin": ["bin/asset-mapper-update"],
    "config": {
        "platform": {"php": "8.2.0"},
        "sort-packages": true
    },
    "scripts": {
        "cs": "php-cs-fixer fix --dry-run --diff",
        "cs-fix": "php-cs-fixer fix",
        "phpstan": "phpstan analyse",
        "test": "phpunit",
        "all": ["@cs", "@phpstan", "@test"]
    }
}
